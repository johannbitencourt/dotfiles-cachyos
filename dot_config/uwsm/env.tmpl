# Changes require a Hyprland session restart to take effect.

source ~/.config/uwsm/default

export PATH="$HOME/.local/bin:$PATH"

{{- $virt := output "sh" "-c" "systemd-detect-virt 2>/dev/null || true" | trim }}
{{- $nvidia := output "sh" "-c" "grep -qs '^0x10de$' /sys/class/drm/card*/device/vendor 2>/dev/null && printf nvidia || true" | trim }}
{{ if ne $virt "none" -}}
# Quickshell software rendering is safer without explicit VM GPU passthrough.
export QT_QUICK_BACKEND=software
{{ else if eq $nvidia "nvidia" -}}
export NVD_BACKEND=direct
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
{{ end -}}

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims)"
fi
