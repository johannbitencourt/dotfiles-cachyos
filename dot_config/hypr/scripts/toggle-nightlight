#!/usr/bin/env bash
set -euo pipefail

if pidof hyprsunset >/dev/null; then
  pkill hyprsunset
  notify-send "Night light off"
else
  if ! command -v hyprsunset >/dev/null 2>&1; then
    notify-send "Night light unavailable" "Install hyprsunset from packages/apps-pacman.txt"
    exit 1
  fi

  uwsm app -- hyprsunset --temperature 4000 >/dev/null 2>&1 &
  notify-send "Night light on" "Temperature: 4000K"
fi
