#!/usr/bin/env bash
set -euo pipefail

mode="${1:-area}"
dir="${XDG_SCREENSHOTS_DIR:-$HOME/Pictures/Screenshots}"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
  output)
    grim "$file"
    ;;
  area)
    grim -g "$(slurp)" "$file"
    ;;
  *)
    printf 'usage: %s [area|output]\n' "$0" >&2
    exit 2
    ;;
esac

wl-copy < "$file"
notify-send "Screenshot saved" "$file"
