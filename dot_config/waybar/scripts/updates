#!/usr/bin/env bash
set -euo pipefail

updates=0

if command -v checkupdates >/dev/null 2>&1; then
  updates=$((updates + $(checkupdates 2>/dev/null | wc -l)))
fi

if command -v paru >/dev/null 2>&1; then
  updates=$((updates + $(paru -Qua 2>/dev/null | wc -l)))
fi

if (( updates > 0 )); then
  printf '{"text":" %s","tooltip":"%s updates available","class":"available"}\n' "$updates" "$updates"
else
  printf '{"text":"","tooltip":"System up to date","class":"current"}\n'
fi
